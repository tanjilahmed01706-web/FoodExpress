{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Customer orders flowing through the delivery pipeline"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderNumber": { "type": "string", "unique": true },
    "customer": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user", "required": true },
    "restaurant": { "type": "relation", "relation": "manyToOne", "target": "api::restaurant.restaurant", "required": true },
    "rider": { "type": "relation", "relation": "manyToOne", "target": "api::rider.rider" },
    "items": { "type": "json", "required": true },
    "subtotal": { "type": "decimal", "default": 0 },
    "deliveryFee": { "type": "decimal", "default": 0 },
    "tax": { "type": "decimal", "default": 0 },
    "discount": { "type": "decimal", "default": 0 },
    "total": { "type": "decimal", "default": 0 },
    "couponCode": { "type": "string" },
    "paymentMethod": { "type": "enumeration", "enum": ["cod", "card"], "default": "cod" },
    "paymentStatus": { "type": "enumeration", "enum": ["pending", "paid", "refunded"], "default": "pending" },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "preparing", "ready", "picked_up", "on_the_way", "delivered", "cancelled"],
      "default": "pending"
    },
    "deliveryAddress": { "type": "json" },
    "customerNote": { "type": "string" },
    "cancelReason": { "type": "string" },
    "timeline": { "type": "json" },
    "riderEarning": { "type": "decimal", "default": 0 },
    "placedAt": { "type": "datetime" },
    "deliveredAt": { "type": "datetime" }
  }
}
